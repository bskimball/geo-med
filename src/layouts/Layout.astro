---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import '../styles/global.css';

interface Props {
  bodyClass?: string;
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string[];
  image?:
    | string
    | {
        src: string;
        alt?: string;
        width?: number;
        height?: number;
      };
  ogType?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
  extraMeta?: {
    name?: string;
    property?: string;
    content: string;
  }[];
}
let {
  bodyClass = 'min-h-screen bg-base-100 text-base-content flex flex-col',
  title = 'George Medairy',
  description = 'Personal website of George Medairy, a real estate agent in Delaware. Helping you find your dream home in the First State.',
  canonical,
  keywords = [],
  image,
  ogType,
  noindex,
  structuredData = [],
  extraMeta = [],
} = Astro.props;

const combinedKeywords = keywords.length
  ? Array.from(new Set([...SITE.keywords, ...keywords]))
  : SITE.keywords;
---

<!doctype html>
<html lang={SITE.language} data-theme="context7">
  <BaseHead
    title={title}
    description={description}
    canonical={canonical}
    keywords={combinedKeywords}
    image={image}
    ogType={ogType}
    noindex={noindex}
    structuredData={structuredData}
    extraMeta={extraMeta}
  />
  <body class={bodyClass}>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
