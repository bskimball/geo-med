---
import { siFacebook, siInstagram } from 'simple-icons';
import { Mail, Phone, MapPin, Shield } from '@lucide/astro';

let date = new Date();
let year = date.getFullYear();
---

<footer class="bg-secondary text-secondary-content">
  <div class="container mx-auto max-w-7xl px-4">
    <!-- Main Footer Content -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 py-16 border-b border-white/10"
    >
      <!-- About Section -->
      <div class="space-y-4">
        <h3
          class="text-2xl md:text-3xl font-bold text-accent"
          style="font-family: var(--font-serif);"
        >
          George Medairy
        </h3>
        <p class="text-secondary-content/80 leading-relaxed">
          Your trusted Delaware real estate expert serving residential buyers,
          sellers, and veterans. Helping you find your place to call home.
        </p>
        <div
          class="inline-flex items-center gap-2 bg-accent/20 px-4 py-2.5 rounded-lg"
        >
          <Shield class="w-5 h-5 text-accent" />
          <span class="text-sm font-semibold text-accent"
            >Veteran-Friendly Agent</span
          >
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4
          class="font-bold text-xl text-accent uppercase tracking-wider"
          style="font-family: var(--font-sans);"
        >
          Quick Links
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/"
              class="text-secondary-content/80 hover:text-accent transition-colors"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="text-secondary-content/80 hover:text-accent transition-colors"
            >
              About Me
            </a>
          </li>
          <li>
            <a
              href="/explore"
              class="text-secondary-content/80 hover:text-accent transition-colors"
            >
              Explore Properties
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-secondary-content/80 hover:text-accent transition-colors"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Services -->
      <div class="space-y-4">
        <h4
          class="font-bold text-xl text-accent uppercase tracking-wider"
          style="font-family: var(--font-sans);"
        >
          Services
        </h4>
        <ul class="space-y-3">
          <li class="text-secondary-content/80">Residential Sales</li>
          <li class="text-secondary-content/80">Property Listings</li>
          <li class="text-secondary-content/80">VA Loan Assistance</li>
          <li class="text-secondary-content/80">First-Time Buyer Support</li>
          <li class="text-secondary-content/80">Market Analysis</li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h4
          class="font-bold text-xl text-accent uppercase tracking-wider"
          style="font-family: var(--font-sans);"
        >
          Get In Touch
        </h4>
        <div class="space-y-3">
          <a
            href="tel:+18149312411"
            class="flex items-center gap-3 text-secondary-content/80 hover:text-accent transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center group-hover:bg-accent/30 transition-colors"
            >
              <Phone class="w-5 h-5 text-accent" />
            </div>
            <span>(814) 931-2411</span>
          </a>

          <a
            href="mailto:george@medairyrealestate.com"
            class="flex items-center gap-3 text-secondary-content/80 hover:text-accent transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center group-hover:bg-accent/30 transition-colors"
            >
              <Mail class="w-5 h-5 text-accent" />
            </div>
            <span class="break-all">george@medairyrealestate.com</span>
          </a>

          <div class="flex items-center gap-3 text-secondary-content/80">
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center"
            >
              <MapPin class="w-5 h-5 text-accent" />
            </div>
            <span>Delaware, USA</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-secondary-content/70">
          &copy; {year} George Medairy Real Estate. All rights reserved.
        </p>

        <div class="flex items-center gap-4">
          <span class="text-secondary-content/70">Follow me:</span>
          <div class="flex gap-3">
            <a
              href="#"
              class="w-11 h-11 rounded-lg bg-white/10 hover:bg-accent/30 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:-translate-y-1 fill-secondary-content hover:fill-accent"
              aria-label="Facebook"
            >
              <div class="w-5 h-5" set:html={siFacebook.svg} />
            </a>
            <a
              href="#"
              class="w-11 h-11 rounded-lg bg-white/10 hover:bg-accent/30 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:-translate-y-1 fill-secondary-content hover:fill-accent"
              aria-label="Instagram"
            >
              <div class="w-5 h-5" set:html={siInstagram.svg} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
