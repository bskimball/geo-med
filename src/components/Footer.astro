---
import { siFacebook, siInstagram } from 'simple-icons';
import { Mail, Phone, MapPin, Shield } from '@lucide/astro';

let date = new Date();
let year = date.getFullYear();
---

<footer
  class="relative text-white overflow-hidden border-t-4 border-primary"
  style="background: linear-gradient(45deg, #2c4a3e 0%, #3a6250 35%, #a85d44 100%);"
>
  <!-- Dot Pattern Overlay -->
  <div
    class="absolute inset-0 opacity-40 pointer-events-none"
    style="background-image: radial-gradient(circle, rgba(217,160,91,0.3) 1px, transparent 1px); background-size: 24px 24px;"
  >
  </div>

  <div class="container mx-auto max-w-7xl px-4 relative z-10">
    <!-- Main Footer Content -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 py-16 border-b border-white/10"
    >
      <!-- About Section -->
      <div class="space-y-4">
        <h3
          class="text-2xl md:text-3xl font-bold text-accent"
          style="font-family: var(--font-serif);"
        >
          George Medairy
        </h3>
        <p class="text-white text-lg font-medium leading-relaxed">
          Your trusted Delaware real estate expert serving residential buyers,
          sellers, and Community Heroes across the First State.
        </p>
        <div
          class="inline-flex items-center gap-2 bg-accent/20 px-4 py-2.5 rounded-lg border border-accent/30"
        >
          <Shield class="w-5 h-5 text-accent" />
          <span class="text-sm font-semibold text-accent"
            >Homes for Heroes Affiliate</span
          >
        </div>
      </div>

      <!-- Navigation -->
      <div class="space-y-4">
        <h4
          class="font-bold text-accent uppercase tracking-wider"
          style="font-family: var(--font-sans);"
        >
          Quick Links
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/"
              class="text-white/80 hover:text-accent transition-colors"
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="text-white/80 hover:text-accent transition-colors"
            >
              About Me
            </a>
          </li>
          <li>
            <a
              href="/explore"
              class="text-white/80 hover:text-accent transition-colors"
            >
              Explore Properties
            </a>
          </li>
          <li>
            <a
              href="/areas"
              class="text-white/80 hover:text-accent transition-colors"
            >
              Area Guides
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-white/80 hover:text-accent transition-colors"
            >
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h4
          class="font-bold text-accent uppercase tracking-wider"
          style="font-family: var(--font-sans);"
        >
          Get In Touch
        </h4>
        <div class="space-y-3">
          <a
            href="tel:+18149312411"
            class="flex items-center gap-3 text-white/80 hover:text-accent transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center group-hover:bg-accent/30 transition-colors"
            >
              <Phone class="w-5 h-5 text-accent" />
            </div>
            <span>(814) 931-2411</span>
          </a>

          <a
            href="mailto:george@medairyrealestate.com"
            class="flex items-center gap-3 text-white/80 hover:text-accent transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center group-hover:bg-accent/30 transition-colors"
            >
              <Mail class="w-5 h-5 text-accent" />
            </div>
            <span>george@medairyrealestate.com</span>
          </a>

          <div class="flex items-center gap-3 text-white/80">
            <div
              class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center"
            >
              <MapPin class="w-5 h-5 text-accent" />
            </div>
            <span>Delaware, USA</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/70">
          &copy; {year} George Medairy Real Estate. All rights reserved.
        </p>

        <div class="flex items-center gap-4">
          <span class="text-white/70">Follow me:</span>
          <div class="flex gap-3">
            <a
              href="https://www.facebook.com/profile.php?id=61583597131998"
              class="w-11 h-11 rounded-lg bg-white/10 hover:bg-accent/30 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:-translate-y-1 fill-white hover:fill-accent"
              aria-label="Facebook"
            >
              <div class="w-5 h-5" set:html={siFacebook.svg} />
            </a>
            <a
              href="https://www.instagram.com/georgemedairy3"
              class="w-11 h-11 rounded-lg bg-white/10 hover:bg-accent/30 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:-translate-y-1 fill-white hover:fill-accent"
              aria-label="Instagram"
            >
              <div class="w-5 h-5" set:html={siInstagram.svg} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
