---
interface Props {
  title: string;
  className?: string;
}

const { title, className = '' } = Astro.props as Props;
---

<div
  class={`card bg-base-100 shadow-xl service-card rounded-lg overflow-hidden border ${className}`.trim()}
>
  <div class="relative h-56 overflow-hidden">
    <slot name="media">
      <div class="w-full h-full bg-base-200" aria-hidden="true"></div>
    </slot>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent">
    </div>
    <div class="absolute bottom-4 left-4 right-4">
      <h3 class="text-white font-bold text-2xl text-shadow">
        {title}
      </h3>
    </div>
  </div>
  <div class="card-body">
    <slot />
  </div>
</div>
