---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import georgeThumbsUp from '../assets/george-thumbs-up.jpg';
import georgeUpClose from '../assets/george-up-close.jpg';
import dreamHome from '../assets/dream-home.jpg';
import sellHome from '../assets/sell-home.jpg';
import rentHome from '../assets/rent-home.jpg';
import remaxLogo from '../assets/remax-logo.svg';
import soldHomeBkg from '../assets/sold-home-bkg.jpg';
import georgeJacket from '../assets/george-jacket.png';
import iconBackground from '../assets/icon-background.png';
import delawareRoadMap from '../assets/delaware-road-map.png';
import {
  ArrowRightToLine,
  Search,
  BadgeCheck,
  Rocket,
  CircleCheck,
  Shield,
  Award,
  TrendingUp,
  Users,
  Phone,
  House as Home,
  MousePointerClick,
} from '@lucide/astro';
import Navbar from '../components/Navbar.astro';
import ServiceCard from '../components/ServiceCard.astro';

const optimizedSoldHomeBkg = await getImage({
  src: soldHomeBkg,
  format: 'webp',
});

const optimizedGeorgeJacket = await getImage({
  src: georgeJacket,
  format: 'webp',
});

const optimizedIconBackground = await getImage({
  src: iconBackground,
  format: 'webp',
});

const optimizedDelawareRoadMap = await getImage({
  src: delawareRoadMap,
  format: 'webp',
});
---

<Layout
  title="George Medairy - Delaware Real Estate Agent | Serving Residential & Veterans"
  description="Expert Delaware real estate agent specializing in residential properties and VA loans. Trusted by veterans and families. Find your dream home today."
>
  <!-- Hero Section -->
  <div class="relative h-screen overflow-hidden">
    <!-- Background Image -->
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url(${optimizedSoldHomeBkg.src});`}
    >
    </div>
    <div class="absolute inset-0 hero-gradient"></div>

    <!-- Navbar -->
    <header class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20">
      <Navbar />
    </header>

    <!-- Hero Content Container -->
    <div class="relative h-[calc(100vh-5rem)]">
      <!-- George Image - Right Side, Full Height -->
      <div class="hidden lg:block absolute inset-y-0 right-0 w-[50vw]">
        <Image
          src={georgeJacket}
          alt="George Medairy - Your Delaware Real Estate Expert"
          class="hero-image drop-shadow-2xl w-full h-full object-cover object-bottom"
        />
      </div>

      <!-- Text Content - Overlays Image -->
      <div class="relative z-10 h-full">
        <div class="container mx-auto max-w-7xl px-4 h-full flex items-center">
          <div class="w-full lg:w-[55%] space-y-8 animate-fade-in-up">
            <div class="inline-block">
              <span class="badge-veteran">
                <Shield class="w-4 h-4" />
                Veteran-Friendly Agent
              </span>
            </div>

            <h1 class="text-white text-shadow-lg">
              Find Your Home in the <span class="text-accent">First State</span>
            </h1>

            <p class="text-xl text-white/90 text-shadow leading-relaxed">
              Trusted Delaware real estate expert serving residential buyers,
              sellers, and proud veterans. Whether you're using a VA loan or
              traditional financing, I'll guide you home.
            </p>

            <div class="flex flex-wrap gap-4">
              <a href="/explore" class="btn btn-accent btn-lg">
                <Search class="w-5 h-5 mr-1" />
                Browse Homes
              </a>
              <a href="/contact" class="btn btn-secondary btn-lg">
                <MousePointerClick class="w-5 h-5 mr-1" />
                Get Started
              </a>
            </div>

            <!-- Trust Indicators -->
            <div class="flex flex-wrap gap-x-8 gap-y-4 pt-6">
              <div
                class="flex items-center gap-3 text-white/90 trust-indicator"
              >
                <div
                  class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0"
                >
                  <Award class="w-6 h-6 text-accent" />
                </div>
                <div>
                  <div class="font-bold">Dedicated</div>
                  <div class="text-sm text-white/70">Personal Service</div>
                </div>
              </div>
              <div
                class="flex items-center gap-3 text-white/90 trust-indicator"
              >
                <div
                  class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0"
                >
                  <Users class="w-6 h-6 text-accent" />
                </div>
                <div>
                  <div class="font-bold">Always Available</div>
                  <div class="text-sm text-white/70">24/7 Support</div>
                </div>
              </div>
              <div
                class="flex items-center gap-3 text-white/90 trust-indicator"
              >
                <div
                  class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center flex-shrink-0"
                >
                  <TrendingUp class="w-6 h-6 text-accent" />
                </div>
                <div>
                  <div class="font-bold">Local Expert</div>
                  <div class="text-sm text-white/70">Delaware Specialist</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Section -->
  <section class="py-20 services-section" style="background-color: var(--color-section-sage);">
    <div class="container mx-auto max-w-7xl px-4">
      <div class="text-center mb-16 max-w-3xl mx-auto section-header">
        <span class="text-accent font-semibold uppercase tracking-wider text-sm"
          >Services</span
        >
        <h2 class="mt-4 mb-6">Your Real Estate Journey, Simplified</h2>
        <p class="text-lg text-base-content/70">
          Whether you're buying, selling, or investing, I provide expert
          guidance tailored to your unique needs and goals.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 service-cards"
      >
        <ServiceCard title="Buy Your Home">
          <Image
            slot="media"
            src={dreamHome}
            alt="Buy Your Dream Home"
            class="card-image w-full h-full object-cover"
          />
          <p class="text-base-content/80 mb-4">
            From first-time buyers to seasoned investors, I'll help you find the
            perfect property that fits your lifestyle and budget.
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Personalized property search</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Negotiation expertise</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Market insights & analysis</span>
            </li>
          </ul>
        </ServiceCard>

        <ServiceCard title="Sell For Top Dollar">
          <Image
            slot="media"
            src={sellHome}
            alt="Sell Your Property"
            class="card-image w-full h-full object-cover"
          />
          <p class="text-base-content/80 mb-4">
            Strategic marketing and pricing to ensure you get maximum value for
            your property in the shortest time possible.
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Professional staging advice</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Strategic pricing analysis</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Multi-channel marketing</span>
            </li>
          </ul>
        </ServiceCard>

        <ServiceCard title="Find Rentals">
          <Image
            slot="media"
            src={rentHome}
            alt="Rental Properties"
            class="card-image w-full h-full object-cover"
          />
          <p class="text-base-content/80 mb-4">
            Discover quality rental properties that match your lifestyle,
            budget, and location preferences throughout Delaware.
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Curated rental listings</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Lease negotiation support</span>
            </li>
            <li class="flex items-center gap-2">
              <CircleCheck class="w-4 h-4 text-accent flex-shrink-0" />
              <span>Landlord relations</span>
            </li>
          </ul>
        </ServiceCard>
      </div>
    </div>
  </section>

  <!-- Veteran Section -->
  <section class="py-24 relative overflow-hidden bg-gradient-to-br from-[#2c3e50] via-[#34495e] to-[#2c3e50]">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, currentColor 2px, currentColor 4px), repeating-linear-gradient(90deg, transparent, transparent 2px, currentColor 2px, currentColor 4px); background-size: 40px 40px;"></div>
    </div>
    <div class="absolute top-0 right-0 w-1/2 h-full opacity-10 bg-gradient-to-l from-accent/30 to-transparent"></div>

    <div class="container mx-auto max-w-7xl px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left Content -->
        <div class="space-y-8">
          <!-- Badge -->
          <div class="inline-flex items-center gap-3 bg-accent/20 backdrop-blur-sm px-5 py-2.5 rounded-full border border-accent/30">
            <Shield class="w-5 h-5 text-accent" />
            <span class="font-semibold uppercase tracking-[0.15em] text-sm text-accent">Proudly Serving Veterans</span>
          </div>

          <!-- Heading -->
          <div>
            <h2 class="text-white text-shadow mb-4">Honoring Those Who Served</h2>
            <div class="w-20 h-1 bg-gradient-to-r from-accent to-accent/30 rounded-full"></div>
          </div>

          <p class="text-lg text-white/80 leading-relaxed">
            As a dedicated advocate for veterans, I specialize in VA home loans
            and understand the unique benefits available to those who've served
            our nation. Let me help you leverage your hard-earned benefits to
            find the perfect home.
          </p>

          <!-- Feature Cards - Redesigned -->
          <div class="space-y-3">
            <!-- Card 1 -->
            <div class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500">
                  <BadgeCheck class="w-6 h-6 text-accent" />
                </div>
                <div class="flex-1">
                  <h4 class="font-bold text-white mb-1">VA Loan Expertise</h4>
                  <p class="text-white/70">
                    Navigate the VA loan process with confidence and maximize your
                    benefits.
                  </p>
                </div>
              </div>
              <!-- Decorative corner accent -->
              <div class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"></div>
                <div class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"></div>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500">
                  <TrendingUp class="w-6 h-6 text-accent" />
                </div>
                <div class="flex-1">
                  <h4 class="font-bold text-white mb-1">Zero Down Payment Options</h4>
                  <p class="text-white/70">
                    Explore homes with little to no money down through VA
                    financing.
                  </p>
                </div>
              </div>
              <!-- Decorative corner accent -->
              <div class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"></div>
                <div class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"></div>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500">
                  <Award class="w-6 h-6 text-accent" />
                </div>
                <div class="flex-1">
                  <h4 class="font-bold text-white mb-1">Dedicated Support</h4>
                  <p class="text-white/70">
                    Personalized service that respects and honors your military
                    background.
                  </p>
                </div>
              </div>
              <!-- Decorative corner accent -->
              <div class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"></div>
                <div class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"></div>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-accent btn-lg inline-flex mt-4 group">
            <span>Schedule Consultation</span>
            <Rocket class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>

        <!-- Right Image -->
        <div class="relative lg:pl-8">
          <!-- Decorative frame -->
          <div class="absolute -inset-4 bg-gradient-to-br from-accent/20 via-accent/5 to-transparent rounded-3xl blur-2xl"></div>
          <div class="absolute -top-6 -left-6 w-24 h-24 border-l-2 border-t-2 border-accent/40 rounded-tl-3xl"></div>
          <div class="absolute -bottom-6 -right-6 w-24 h-24 border-r-2 border-b-2 border-accent/40 rounded-br-3xl"></div>

          <Image
            src={georgeUpClose}
            alt="George Medairy - Veteran Real Estate Specialist"
            class="relative rounded-2xl shadow-2xl veteran-image"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-20 pattern-grid process-section" style="background-color: var(--color-section-blue);">
    <div class="container mx-auto max-w-7xl px-4">
      <div class="text-center mb-16 max-w-3xl mx-auto section-header">
        <span class="text-accent font-semibold uppercase tracking-wider text-sm"
          >The Process</span
        >
        <h2 class="mt-4 mb-6">Your Path to Success</h2>
        <p class="text-lg text-base-content/70">
          A proven, straightforward approach to help you achieve your real
          estate goals with confidence.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 process-step"
        >
          <div
            class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6"
          >
            <ArrowRightToLine class="w-8 h-8 text-primary" />
          </div>
          <div
            class="text-accent font-bold text-sm uppercase tracking-wider mb-2"
          >
            Step 1
          </div>
          <h3 class="mb-4">Initial Consultation</h3>
          <p class="text-base-content/70">
            We start with a personalized conversation to understand your goals,
            budget, timeline, and unique needs. This foundation ensures we're
            aligned from day one.
          </p>
        </div>

        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 process-step"
        >
          <div
            class="w-16 h-16 rounded-full bg-secondary/10 flex items-center justify-center mb-6"
          >
            <Search class="w-8 h-8 text-secondary" />
          </div>
          <div
            class="text-accent font-bold text-sm uppercase tracking-wider mb-2"
          >
            Step 2
          </div>
          <h3 class="mb-4">Property Search & Strategy</h3>
          <p class="text-base-content/70">
            I'll curate a targeted list of properties that match your criteria,
            schedule viewings, and provide market insights to help you make
            informed decisions.
          </p>
        </div>

        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 process-step"
        >
          <div
            class="w-16 h-16 rounded-full bg-accent/10 flex items-center justify-center mb-6"
          >
            <BadgeCheck class="w-8 h-8 text-accent" />
          </div>
          <div
            class="text-accent font-bold text-sm uppercase tracking-wider mb-2"
          >
            Step 3
          </div>
          <h3 class="mb-4">Closing with Confidence</h3>
          <p class="text-base-content/70">
            From negotiation to paperwork, I'll guide you through every detail
            ensuring a smooth, stress-free closing process.
          </p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/contact" class="btn btn-primary btn-lg">
          Start Your Journey
          <Rocket class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Me Section -->
  <section class="py-20 relative overflow-hidden" style="background: linear-gradient(135deg, #2c4a3e 0%, #3a6250 50%, #2c4a3e 100%);">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-0 left-0 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-secondary/20 rounded-full blur-3xl"></div>
    </div>

    <!-- Pattern Overlay -->
    <div
      class="absolute inset-0 opacity-[0.08] pointer-events-none"
      style="background-image: radial-gradient(circle, rgba(217,160,91,0.4) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <div class="container mx-auto max-w-7xl px-4 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1 relative">
          <!-- Decorative accent around image -->
          <div class="absolute -inset-3 bg-gradient-to-br from-accent/30 via-accent/10 to-transparent rounded-3xl blur-xl"></div>
          <div class="absolute -top-4 -left-4 w-20 h-20 border-l-2 border-t-2 border-accent/50 rounded-tl-2xl"></div>
          <div class="absolute -bottom-4 -right-4 w-20 h-20 border-r-2 border-b-2 border-accent/50 rounded-br-2xl"></div>

          <Image
            src={georgeThumbsUp}
            alt="George Medairy - Trusted Delaware Realtor"
            class="relative rounded-2xl shadow-2xl"
          />
        </div>

        <div class="order-1 lg:order-2 space-y-6">
          <div class="inline-flex items-center gap-2 bg-accent/20 backdrop-blur-sm px-4 py-2 rounded-full border border-accent/30">
            <Award class="w-4 h-4 text-accent" />
            <span class="text-accent font-semibold uppercase tracking-wider text-sm">Why Choose Me</span>
          </div>

          <h2 class="text-white text-shadow">Commitment You Can Trust</h2>

          <p class="text-lg text-white/90 leading-relaxed">
            As a dedicated Delaware real estate professional, I bring fresh
            energy, modern marketing strategies, and unwavering commitment to
            helping you achieve your real estate goals.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4 bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20 hover:bg-white/15 transition-all duration-300">
              <div
                class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center flex-shrink-0 mt-1 border border-accent/30"
              >
                <CircleCheck class="w-6 h-6 text-accent" />
              </div>
              <div>
                <h4 class="font-bold mb-1 text-white">Deep Local Knowledge</h4>
                <p class="text-white/80 text-sm">
                  Extensive understanding of Delaware neighborhoods, schools,
                  and market trends.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20 hover:bg-white/15 transition-all duration-300">
              <div
                class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center flex-shrink-0 mt-1 border border-accent/30"
              >
                <CircleCheck class="w-6 h-6 text-accent" />
              </div>
              <div>
                <h4 class="font-bold mb-1 text-white">Personalized Approach</h4>
                <p class="text-white/80 text-sm">
                  Every client is unique. I tailor my strategy to your specific
                  goals and timeline.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/20 hover:bg-white/15 transition-all duration-300">
              <div
                class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center flex-shrink-0 mt-1 border border-accent/30"
              >
                <CircleCheck class="w-6 h-6 text-accent" />
              </div>
              <div>
                <h4 class="font-bold mb-1 text-white">Client-Focused Dedication</h4>
                <p class="text-white/80 text-sm">
                  Your success is my priority. I'm committed to providing
                  exceptional service and being available whenever you need me.
                </p>
              </div>
            </div>
          </div>

          <a href="/about" class="btn btn-accent inline-flex">
            Learn More About Me
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-20 relative overflow-hidden"
    style="background-color: var(--color-section-cream);"
  >
    <div
      class="absolute inset-0 opacity-10"
      style={`background-image: url(${optimizedDelawareRoadMap.src}); background-size: cover; background-position: center;`}
    >
    </div>
    <div class="container mx-auto max-w-4xl px-4 text-center relative z-10">
      <h2 class="mb-6">
        Ready to Find Your Dream Home?
      </h2>
      <p class="text-xl text-base-content/80 mb-8 max-w-2xl mx-auto">
        Whether you're buying, selling, or just exploring your options, I'm here
        to help. Let's start a conversation about your real estate goals today.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn btn-accent btn-lg">
          <Phone class="w-5 h-5" />
          Contact Me Today
        </a>
        <a href="/explore" class="btn btn-secondary btn-lg">
          <Home class="w-5 h-5" />
          Browse Properties
        </a>
      </div>

      <div class="mt-12 inline-flex bg-white rounded-2xl p-6 shadow-2xl">
        <img
          src={remaxLogo.src}
          alt="RE/MAX - Nobody in the world sells more real estate"
          class="h-16"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Wait for DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Hero Section Animations
    const heroTimeline = gsap.timeline({ delay: 0.3 });

    const fadeInUpElements = document.querySelectorAll('.animate-fade-in-up');
    if (fadeInUpElements.length > 0) {
      heroTimeline.fromTo(
        '.animate-fade-in-up',
        {
          y: 60,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 1,
          ease: 'power3.out',
        }
      );
    }

    const trustIndicators = document.querySelectorAll('.trust-indicator');
    if (trustIndicators.length > 0) {
      heroTimeline.fromTo(
        '.trust-indicator',
        {
          y: 30,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power2.out',
        },
        '-=0.5'
      );
    }

    // Section Headers Animation
    gsap.utils.toArray('.section-header').forEach((header) => {
      const element = header as HTMLElement;
      gsap.fromTo(
        element.children,
        {
          y: 30,
          opacity: 0,
        },
        {
          scrollTrigger: {
            trigger: element,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power2.out',
        }
      );
    });

    // Service Cards Scroll Animation
    const serviceCards = document.querySelectorAll('.service-card');
    if (serviceCards.length > 0) {
      gsap.fromTo(
        serviceCards,
        {
          y: 80,
          opacity: 0,
        },
        {
          scrollTrigger: {
            trigger: '.services-section',
            start: 'top 70%',
            toggleActions: 'play none none none',
          },
          y: 0,
          opacity: 1,
          duration: 1,
          stagger: 0.2,
          ease: 'power3.out',
        }
      );
    }

    // Process Steps Animation
    const processSteps = document.querySelectorAll('.process-step');
    if (processSteps.length > 0) {
      gsap.fromTo(
        processSteps,
        {
          scale: 0.85,
          y: 60,
          opacity: 0,
        },
        {
          scrollTrigger: {
            trigger: '.process-section',
            start: 'top 70%',
            toggleActions: 'play none none none',
          },
          scale: 1,
          y: 0,
          opacity: 1,
          duration: 0.9,
          stagger: 0.25,
          ease: 'back.out(1.7)',
        }
      );
    }

    // Button Hover Micro-interactions
    const buttons = document.querySelectorAll('.btn');
    buttons.forEach((button) => {
      button.addEventListener('mouseenter', () => {
        gsap.to(button, {
          scale: 1.05,
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      button.addEventListener('mouseleave', () => {
        gsap.to(button, {
          scale: 1,
          duration: 0.3,
          ease: 'power2.out',
        });
      });
    });

    // Navbar scroll effect
    const navbar = document.querySelector('header');
    let lastScroll = 0;

    if (navbar) {
      gsap.to(navbar, {
        scrollTrigger: {
          trigger: document.body,
          start: '100px top',
          end: 'bottom bottom',
          onUpdate: (self) => {
            const currentScroll = self.scroll();
            if (currentScroll > lastScroll && currentScroll > 100) {
              // Scrolling down
              gsap.to(navbar, { y: -100, duration: 0.3, ease: 'power2.out' });
            } else {
              // Scrolling up
              gsap.to(navbar, { y: 0, duration: 0.3, ease: 'power2.out' });
            }
            lastScroll = currentScroll;
          },
        },
      });
    }

    // Image fade in on scroll - exclude hero image and card images
    const images = document.querySelectorAll(
      'img:not(.hero-image):not(.card-image)'
    );
    images.forEach((img) => {
      gsap.fromTo(
        img,
        {
          opacity: 0,
          scale: 1.05,
        },
        {
          scrollTrigger: {
            trigger: img,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power2.out',
        }
      );
    });

    // Stat counters animation
    const statCounters = document.querySelectorAll('.stat-counter');
    statCounters.forEach((counter) => {
      const target = parseInt(counter.textContent || '0');
      if (target > 0) {
        gsap.from(counter, {
          scrollTrigger: {
            trigger: counter,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
          innerText: 0,
          duration: 2,
          ease: 'power1.out',
          snap: { innerText: 1 },
          onUpdate: function () {
            counter.textContent = Math.ceil(
              this.targets()[0].innerText
            ).toString();
          },
        });
      }
    });
  });
</script>
