---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm';
import {
  Mail,
  Phone,
  Clock,
  MessageCircle,
  Shield,
  Award,
} from '@lucide/astro';
import georgeThumbsUp from '../assets/george-thumbs-up.jpg';
import aboutToCall from '../assets/about-to-call.jpg';
import { Image, getImage } from 'astro:assets';
import { SITE } from '../config/site';

const optimizedAboutToCall = await getImage({
  src: aboutToCall,
  format: 'webp',
});

const contactOgImage = await getImage({
  src: aboutToCall,
  width: 1200,
  height: 630,
  format: 'webp',
});

const contactStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact George Medairy',
    url: `${SITE.site}/contact`,
    description:
      'Reach out to George Medairy for Delaware real estate guidance, VA loan support, and property consultations.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPoint',
    telephone: SITE.contact.phone,
    email: SITE.contact.email,
    contactType: 'customer service',
    areaServed: SITE.serviceAreas,
    availableLanguage: 'English',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE.site,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Contact',
        item: `${SITE.site}/contact`,
      },
    ],
  },
];
---

<Layout
  title="Contact George Medairy - Delaware Real Estate Agent"
  description="Ready to find your dream home in Delaware? Contact George Medairy today for expert real estate guidance. Serving residential buyers and veterans."
  keywords={[
    'contact George Medairy',
    'Delaware realtor contact',
    'schedule Delaware home consultation',
    'speak with VA loan specialist Delaware',
  ]}
  image={{
    src: contactOgImage.src,
    width: 1200,
    height: 630,
    alt: 'Phone consultation with George Medairy, Delaware real estate agent',
  }}
  structuredData={contactStructuredData}
>
  <div class="min-h-screen">
    {/* Hero Section */}
    <div class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <!-- Background Image -->
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url(${optimizedAboutToCall.src});`}
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>

      <!-- Navbar -->
      <header
        class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20"
      >
        <Navbar />
      </header>

      <!-- Hero Content -->
      <div class="relative h-[calc(60vh-5rem)] min-h-[420px]">
        <div class="relative z-10 h-full">
          <div
            class="container mx-auto max-w-7xl px-4 h-full flex items-center"
          >
            <div
              class="w-full max-w-3xl mx-auto text-center space-y-6 animate-fade-in-up"
            >
              <div class="inline-block">
                <span class="badge-veteran">
                  <MessageCircle class="w-4 h-4" />
                  Let's Connect
                </span>
              </div>
              <h1 class="text-white text-shadow-lg">
                Ready to Find Your Home?
              </h1>
              <p class="text-xl text-white/90 text-shadow leading-relaxed">
                Whether you're buying, selling, or just have questions about the
                Delaware real estate market—I'm here to help. Let's start a
                conversation about your goals.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Main Contact Section */}
    <section
      class="py-20"
      style="background-color: var(--color-section-light);"
    >
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-8">
          {/* Contact Form */}
          <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-xl p-8 lg:p-12">
              <div class="mb-8">
                <span
                  class="text-accent font-semibold uppercase tracking-wider text-sm"
                  >Get In Touch</span
                >
                <h2 class="mt-4 mb-4">Send Me a Message</h2>
                <p class="text-base-content/70 text-lg">
                  Fill out the form below and I'll get back to you within 24
                  hours. Or call/email me directly for immediate assistance.
                </p>
              </div>
              <ContactForm client:load />
            </div>
          </div>

          {/* Sidebar */}
          <div class="space-y-8">
            {/* Agent Card */}
            <div class="bg-white rounded-2xl shadow-xl p-8">
              <div class="text-center mb-6">
                <Image
                  src={georgeThumbsUp}
                  alt="George Medairy - Delaware Real Estate Expert"
                  class="rounded-xl mx-auto shadow-lg object-cover mb-4"
                />
                <h3
                  class="font-bold text-xl"
                  style="font-family: var(--font-serif);"
                >
                  George Medairy
                </h3>
                <p class="text-base-content/70 text-sm">
                  Delaware Real Estate Expert
                </p>
              </div>

              <div class="space-y-3">
                <div
                  class="flex items-center gap-3 text-sm bg-base-200 rounded-lg p-3"
                >
                  <Shield class="w-5 h-5 text-secondary flex-shrink-0" />
                  <span>Homes for Heroes Affiliate</span>
                </div>
                <div
                  class="flex items-center gap-3 text-sm bg-base-200 rounded-lg p-3"
                >
                  <Award class="w-5 h-5 text-primary flex-shrink-0" />
                  <span>Delaware Local</span>
                </div>
              </div>
            </div>

            {/* Why Reach Out */}
            <div
              class="bg-gradient-to-br from-primary/5 to-secondary/5 rounded-2xl border-2 border-accent/20 p-8"
            >
              <h4
                class="font-bold text-lg mb-4"
                style="font-family: var(--font-serif);"
              >
                Why Reach Out?
              </h4>
              <ul class="space-y-3 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-accent mt-1">★</span>
                  <span class="text-base-content/80"
                    >Get a free home valuation</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent mt-1">★</span>
                  <span class="text-base-content/80"
                    >Learn about VA loan benefits</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent mt-1">★</span>
                  <span class="text-base-content/80"
                    >Schedule a property viewing</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent mt-1">★</span>
                  <span class="text-base-content/80"
                    >Market insights & analysis</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent mt-1">★</span>
                  <span class="text-base-content/80"
                    >First-time buyer guidance</span
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        {/* Quick Contact Options - Full Width */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a
            href="tel:+18149312411"
            class="flex items-center gap-4 bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 hover:border-accent/30 border border-transparent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 group"
          >
            <div
              class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors"
            >
              <Phone class="w-7 h-7 text-primary" />
            </div>
            <div>
              <div
                class="text-sm text-base-content/70 uppercase tracking-wider font-semibold"
              >
                Call Now
              </div>
              <div class="text-lg font-bold text-primary">(814) 931-2411</div>
            </div>
          </a>

          <a
            href="mailto:george@medairyrealestate.com"
            class="flex items-center gap-4 bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 hover:border-accent/30 border border-transparent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 group"
          >
            <div
              class="w-14 h-14 rounded-xl bg-secondary/10 flex items-center justify-center group-hover:bg-secondary/20 transition-colors"
            >
              <Mail class="w-7 h-7 text-secondary" />
            </div>
            <div>
              <div
                class="text-sm text-base-content/70 uppercase tracking-wider font-semibold"
              >
                Email Me
              </div>
              <div class="text-sm font-bold text-secondary break-all">
                george@medairyrealestate.com
              </div>
            </div>
          </a>

          <div
            class="flex items-center gap-4 bg-white rounded-xl p-6 shadow-md"
          >
            <div
              class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center"
            >
              <Clock class="w-7 h-7 text-accent" />
            </div>
            <div>
              <div
                class="text-sm text-base-content/70 uppercase tracking-wider font-semibold"
              >
                Available
              </div>
              <div class="text-lg font-bold text-accent">Mon-Sat, 9AM-7PM</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Trust Section */}
    <section class="py-16" style="background-color: var(--color-section-blue);">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto">
          <h3
            class="text-2xl font-bold mb-6"
            style="font-family: var(--font-serif);"
          >
            What Happens After You Reach Out?
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl p-6 shadow-md">
              <div
                class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-primary">1</span>
              </div>
              <h4 class="font-bold mb-2">Quick Response</h4>
              <p class="text-sm text-base-content/70">
                I'll respond within 24 hours (usually much faster) to schedule a
                conversation.
              </p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md">
              <div
                class="w-12 h-12 rounded-full bg-secondary/10 flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-secondary">2</span>
              </div>
              <h4 class="font-bold mb-2">Discovery Call</h4>
              <p class="text-sm text-base-content/70">
                We'll discuss your goals, timeline, and what you're looking for
                in detail.
              </p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md">
              <div
                class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-accent">3</span>
              </div>
              <h4 class="font-bold mb-2">Action Plan</h4>
              <p class="text-sm text-base-content/70">
                I'll create a personalized strategy to help you achieve your
                real estate goals.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
