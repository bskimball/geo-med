---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ContactForm from "../components/ContactForm";
import LoanCalculator from "../components/LoanCalculator";
import { Mail, Phone, MapPin, Clock } from "@lucide/astro";
import georgeThumbsUp from "../assets/george-thumbs-up.jpg";
import iconBackground from "../assets/icon-background.png";
import { Image, getImage } from "astro:assets";

const optimizedIconBackground = await getImage({
  src: iconBackground,
  format: "webp",
});
---

<Layout
  title="Contact - George Medairy"
  description="Get in touch with George Medairy, your trusted real estate agent in Delaware. Contact us today to discuss your real estate needs."
>
  <div class="min-h-screen">
    <header class="bg-primary shadow-xl text-primary-content">
      <Navbar />
    </header>

    {/* Hero Section */}
    <section class="bg-primary text-primary-content py-16">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="text-center">
          <h1 class="text-5xl font-bold mb-4 text-primary-content">
            Get In Touch
          </h1>
          <p class="text-xl text-primary-content/70 max-w-2xl mx-auto">
            Ready to make your real estate dreams come true? Let's start the
            conversation today.
          </p>
        </div>
      </div>
    </section>

    {/* Contact Section */}
    <div class="bg-base-300">
      <div class="container max-w-7xl mx-auto py-16">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
          {/* Contact Form Section */}
          <div class="lg:col-span-3 bg-white rounded-2xl shadow-xl p-8">
            <div class="mb-8">
              <h2 class="text-3xl font-bold text-base-content mb-2">
                Send a Message
              </h2>
              <p class="text-base-content/70">
                Ready to start your real estate journey? Let's discuss your
                needs.
              </p>
            </div>
            <ContactForm client:load />
          </div>

          {/* Contact Info & Image */}
          <div
            class="space-y-8 lg:col-span-2 bg-white rounded-2xl shadow-xl p-8"
          >
            <div class="text-center mb-6">
              <Image
                src={georgeThumbsUp}
                alt="George Medairy"
                class="rounded-xl mx-auto shadow-lg object-cover"
              />
              <h3 class="text-2xl font-bold text-gray-800 mt-4">
                George Medairy
              </h3>
              <p class="text-gray-600">Your Trusted Real Estate Partner</p>
            </div>

            <div class="space-y-4">
              <div class="flex items-center p-4 bg-primary/10 rounded-lg">
                <Mail class="w-6 h-6 text-primary mr-3" />
                <div>
                  <a
                    href="mailto:george@medairyrealestate.com"
                    class="text-primary hover:text-primary/75 transition-colors"
                  >
                    george@medairyrealestate.com
                  </a>
                </div>
              </div>

              <div class="flex items-center p-4 bg-secondary/10 rounded-lg">
                <Phone class="w-6 h-6 text-secondary mr-3" />
                <div>
                  <a
                    href="tel:+18149312411"
                    class="text-secondary hover:text-secondary/75 transition-colors"
                  >
                    (814) 931-2411
                  </a>
                </div>
              </div>

              <div class="flex items-center p-4 bg-accent/10 rounded-lg">
                <MapPin class="w-6 h-6 text-accent mr-3" />
                <div>
                  <p class="text-accent">Delaware, USA</p>
                </div>
              </div>

              <div class="flex items-center p-4 bg-base-300 rounded-lg">
                <Clock class="w-6 h-6 text-base-content mr-3" />
                <div>
                  <p class="text-base-content">Mon-Sat, 9AM-7PM</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Call to Action Section */}
      <div class="bg-primary text-primary-content">
        <div class="container mx-auto max-w-7xl py-16">
          <div class="bg-primary/50 text-center">
            <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
            <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
              Whether you're buying, selling, or just exploring your options,
              I'm here to help you navigate the real estate market with
              confidence.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="tel:+18149312411" class="btn btn-lg btn-secondary">
                Call Now
              </a>
              <a
                href="mailto:george@medairyrealestate.com"
                class="btn btn-lg btn-accent"
              >
                Send Email
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
