---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { Image, getImage } from 'astro:assets';
import {
  MapPin,
  TrendingUp,
  House,
  Waves,
  Landmark,
  Compass,
  ScrollText,
  Star,
  Info,
} from '@lucide/astro';
import { markets } from '../../data/pseo/markets';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  return markets.map((market) => ({
    params: { slug: market.slug },
    props: { market },
  }));
}

const { slug } = Astro.params;
const market = Astro.props.market ?? markets.find((m) => m.slug === slug);

if (!market) {
  return Astro.redirect('/areas');
}

const heroImage = await getImage({
  src: market.hero.image,
  format: 'webp',
  width: 1920,
});

const ogImage = await getImage({
  src: market.hero.image,
  format: 'webp',
  width: 1200,
  height: 630,
  fit: 'cover',
});

const keywords = Array.from(
  new Set([
    `${market.name} real estate`,
    `${market.name} homes for sale`,
    `${market.name} Delaware`,
    `${market.name} beachfront homes`,
    ...market.meta.keywords,
  ])
);

const ogImageUrl = new URL(ogImage.src, SITE.site).toString();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Place',
    name: `${market.name} Real Estate`,
    image: ogImageUrl,
    description: market.description,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: market.coordinates.latitude,
      longitude: market.coordinates.longitude,
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: market.name,
      addressRegion: 'DE',
      addressCountry: 'US',
    },
    url: `${SITE.site}/areas/${market.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE.site,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Delaware Areas',
        item: `${SITE.site}/areas`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: market.name,
        item: `${SITE.site}/areas/${market.slug}`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: market.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<Layout
  title={`${market.name} Real Estate Guide | ${SITE.legalName}`}
  description={market.summary}
  keywords={keywords}
  image={{
    src: ogImage.src,
    alt: market.hero.alt,
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen">
    <div class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url(${heroImage.src});`}
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>

      <header
        class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20"
      >
        <Navbar />
      </header>

      <div class="relative h-[calc(60vh-5rem)] min-h-[420px]">
        <div class="relative z-10 h-full">
          <div
            class="container mx-auto max-w-7xl px-4 h-full flex items-center"
          >
            <div
              class="w-full max-w-3xl mx-auto text-center space-y-6 animate-fade-in-up"
            >
              <div
                class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/40"
              >
                <MapPin class="w-4 h-4 text-white" />
                <span class="uppercase tracking-[0.18em] text-xs text-white/90"
                  >{market.name} · Delaware</span
                >
              </div>
              <h1 class="text-white text-shadow-lg">
                Discover {market.name} Real Estate
              </h1>
              <p
                class="text-xl text-white/90 text-shadow leading-relaxed max-w-3xl mx-auto"
              >
                {market.description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section
      class="py-16"
      style="background-color: var(--color-section-light);"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="grid lg:grid-cols-[2fr,1fr] gap-12 items-start">
          <div class="space-y-6">
            <h2>Why {market.name}?</h2>
            <p class="text-lg text-base-content/70 leading-relaxed">
              {market.summary}
            </p>

            <div class="grid md:grid-cols-3 gap-6">
              {
                market.stats.map((stat) => (
                  <div class="bg-white rounded-2xl shadow-lg p-6 border border-base-200">
                    <div class="flex items-center gap-3 mb-3">
                      <TrendingUp class="w-5 h-5 text-accent" />
                      <span class="text-sm uppercase tracking-wider text-base-content/60">
                        {stat.label}
                      </span>
                    </div>
                    <div
                      class="text-3xl font-bold text-primary"
                      style="font-family: var(--font-serif);"
                    >
                      {stat.value}
                    </div>
                    {stat.detail && (
                      <p class="text-sm text-base-content/60 mt-3">
                        {stat.detail}
                      </p>
                    )}
                  </div>
                ))
              }
            </div>
          </div>

          <div
            class="bg-white rounded-2xl shadow-xl p-8 border border-base-200"
          >
            <h3
              class="text-xl font-semibold mb-4"
              style="font-family: var(--font-serif);"
            >
              Market Snapshot
            </h3>
            <ul class="space-y-3 text-sm text-base-content/70">
              <li class="flex items-start gap-3">
                <Star class="w-4 h-4 text-accent mt-1" />
                <span
                  >Primary property types: {
                    market.propertyTypes.join(', ')
                  }</span
                >
              </li>
              <li class="flex items-start gap-3">
                <Star class="w-4 h-4 text-accent mt-1" />
                <span
                  >Popular buyer profiles: {market.lifestyle.join(', ')}</span
                >
              </li>
              <li class="flex items-start gap-3">
                <Star class="w-4 h-4 text-accent mt-1" />
                <span
                  >Top neighborhoods: {
                    market.neighborhoods.slice(0, 3).join(', ')
                  } & more</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 pattern-grid"
      style="background-color: var(--color-section-sage);"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <span
            class="text-accent font-semibold uppercase tracking-wider text-sm"
            >Market Highlights</span
          >
          <h2 class="mt-4 mb-6">What Makes {market.name} Unique</h2>
          <p class="text-lg text-base-content/70">
            Explore the lifestyle advantages, investment opportunities, and
            signature experiences that define {market.name}.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {
            market.highlights.map((highlight) => (
              <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300">
                <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
                  <House class="w-8 h-8 text-primary" />
                </div>
                <h3 class="mb-4">{highlight.title}</h3>
                <p class="text-base-content/70">{highlight.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20"
      style="background-color: var(--color-section-cream);"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-start">
          <div class="space-y-6">
            <span
              class="text-accent font-semibold uppercase tracking-wider text-sm"
              >Top Neighborhoods</span
            >
            <h2 class="mb-6">Communities You Should Know</h2>
            <p class="text-base-content/70 text-lg leading-relaxed">
              From gated enclaves to waterfront cul-de-sacs, {market.name} offers
              a variety of neighborhoods to suit every buyer profile.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              {
                market.neighborhoods.map((neighborhood) => (
                  <div class="bg-white rounded-xl p-4 border border-base-200 flex items-start gap-3">
                    <MapPin class="w-5 h-5 text-secondary flex-shrink-0 mt-1" />
                    <div>
                      <h4 class="font-semibold">{neighborhood}</h4>
                      <p class="text-sm text-base-content/60">
                        Local insight available upon request.
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <Image
              src={market.hero.image}
              alt={market.hero.alt}
              class="w-full h-72 object-cover"
            />
            <div class="p-8 space-y-4">
              <h3
                class="text-xl font-semibold"
                style="font-family: var(--font-serif);"
              >
                Lifestyle Snapshot
              </h3>
              <ul class="space-y-3 text-sm text-base-content/70">
                {
                  market.lifestyle.map((item) => (
                    <li class="flex items-start gap-3">
                      <Waves class="w-4 h-4 text-accent mt-1" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20 pattern-dots"
      style="background-color: var(--color-section-blue);"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-5">
            <span
              class="text-accent font-semibold uppercase tracking-wider text-sm"
              >Nearby Attractions</span
            >
            <h2 class="text-3xl" style="font-family: var(--font-serif);">
              Minutes From Coastal Delaware Favorites
            </h2>
            <p class="text-base-content/70 text-lg">
              Living in {market.name} gives you quick access to signature Delaware
              destinations, waterfront recreation, and boutique shopping districts.
            </p>
            <ul class="space-y-3 text-sm text-base-content/70">
              {
                market.nearbyAttractions.map((spot) => (
                  <li class="flex items-start gap-3">
                    <Landmark class="w-4 h-4 text-primary mt-1" />
                    <span>{spot}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div
            class="bg-white rounded-2xl shadow-xl p-8 border border-base-200"
          >
            <h3
              class="text-xl font-semibold mb-4"
              style="font-family: var(--font-serif);"
            >
              Property Types in Demand
            </h3>
            <div class="space-y-3 text-sm text-base-content/70">
              {
                market.propertyTypes.map((type) => (
                  <div class="flex items-start gap-3">
                    <Compass class="w-4 h-4 text-secondary mt-1" />
                    <span>{type}</span>
                  </div>
                ))
              }
            </div>
            <div
              class="mt-6 p-5 rounded-xl bg-secondary/10 border border-secondary/30"
            >
              <p class="text-sm text-base-content/70">
                Ask George for off-market opportunities, builder introductions,
                and upcoming listings tailored to your goals.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="py-20"
      style="background-color: var(--color-section-light);"
    >
      <div class="container mx-auto max-w-4xl px-4">
        <div class="text-center mb-12">
          <span
            class="text-accent font-semibold uppercase tracking-wider text-sm"
            >Frequently Asked Questions</span
          >
          <h2 class="mt-4 mb-6">{market.name} Buyer & Investor FAQs</h2>
          <p class="text-lg text-base-content/70">
            Get quick answers about financing, rental potential, and lifestyle
            considerations in {market.name}.
          </p>
        </div>

        <div class="space-y-4">
          {
            market.faqs.map((faq) => (
              <details class="bg-white rounded-xl shadow-md border border-base-200 overflow-hidden">
                <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-4 text-base font-semibold">
                  <span>{faq.question}</span>
                  <ScrollText class="w-5 h-5 text-secondary flex-shrink-0" />
                </summary>
                <div class="px-6 pb-6 text-base-content/70 leading-relaxed text-sm">
                  {faq.answer}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="py-20 relative overflow-hidden"
      style="background: linear-gradient(135deg, #2c4a3e 0%, #3a6250 100%);"
    >
      <div class="absolute inset-0 opacity-10">
        <div class="pattern-dots w-full h-full"></div>
      </div>
      <div
        class="container mx-auto max-w-4xl px-4 text-center relative z-10 text-white"
      >
        <span
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/20 uppercase tracking-[0.2em] text-xs"
        >
          <Info class="w-4 h-4" />
          Local Expertise
        </span>
        <h2 class="mt-6 mb-4 text-4xl text-shadow">{market.cta.heading}</h2>
        <p class="text-lg text-white/85 max-w-2xl mx-auto mb-8 leading-relaxed">
          {market.cta.subheading}
        </p>
        <a
          href={market.cta.actionUrl}
          class="btn btn-accent btn-lg inline-flex items-center gap-2"
        >
          {market.cta.actionText}
        </a>
      </div>
    </section>
  </div>
</Layout>
