---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { Image, getImage } from 'astro:assets';
import { MapPin, ArrowRight, Waves } from '@lucide/astro';
import { markets } from '../../data/pseo/markets';
import delawareBeach from '../../assets/delaware-beach.jpg';
import { SITE } from '../../config/site';

const heroBackground = await getImage({
  src: delawareBeach,
  format: 'webp',
  width: 1920,
});

const ogImage = await getImage({
  src: delawareBeach,
  format: 'webp',
  width: 1200,
  height: 630,
  fit: 'cover',
});

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Delaware Coastal Real Estate Areas',
    url: `${SITE.site}/areas`,
    description:
      'Explore Delaware coastal real estate markets including Rehoboth Beach, Bethany Beach, Dewey Beach, and Lewes with George Medairy.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE.site,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Delaware Areas',
        item: `${SITE.site}/areas`,
      },
    ],
  },
];
---

<Layout
  title="Delaware Coastal Real Estate Areas | George Medairy"
  description="Explore Delaware beach towns and real estate markets with curated guides for Rehoboth Beach, Bethany Beach, Dewey Beach, Lewes, and more."
  keywords={[
    'Delaware coastal real estate',
    'Rehoboth Beach area guide',
    'Bethany Beach real estate market',
    'Dewey Beach investment properties',
    'Lewes Delaware homes',
  ]}
  image={{
    src: ogImage.src,
    alt: 'Stylized map of Delaware coastal real estate markets',
  }}
  structuredData={structuredData}
>
  <div class="min-h-screen">
    <div class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url(${heroBackground.src});`}
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>

      <header
        class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20"
      >
        <Navbar />
      </header>

      <div class="relative h-[calc(60vh-5rem)] min-h-[420px]">
        <div class="relative z-10 h-full">
          <div
            class="container mx-auto max-w-7xl px-4 h-full flex items-center"
          >
            <div
              class="w-full max-w-3xl mx-auto text-center space-y-6 animate-fade-in-up"
            >
              <div class="inline-block">
                <span class="badge-veteran">
                  <MapPin class="w-4 h-4" />
                  Delaware Coastal Areas
                </span>
              </div>
              <h1 class="text-white text-shadow-lg">
                Delaware Coastal Communities
              </h1>
              <p class="text-xl text-white/90 text-shadow leading-relaxed">
                Compare lifestyle, investment potential, and neighborhood
                highlights across Delaware’s most sought-after beach towns.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section
      class="py-20"
      style="background-color: var(--color-section-light);"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <span
            class="text-accent font-semibold uppercase tracking-wider text-sm"
            >Programmatic SEO Hub</span
          >
          <h2 class="mt-4 mb-6">Featured Delaware Market Guides</h2>
          <p class="text-lg text-base-content/70">
            Each guide is built from structured data—making it easy to scale new
            pages for additional coastal neighborhoods and property niches.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {
            markets.map((market) => (
              <article class="bg-white rounded-2xl shadow-lg overflow-hidden border border-base-200 flex flex-col">
                <Image
                  src={market.hero.image}
                  alt={market.hero.alt}
                  class="w-full h-56 object-cover"
                  width={800}
                  height={480}
                  fit="cover"
                />
                <div class="p-8 flex flex-col flex-1">
                  <div class="flex items-center gap-2 text-sm text-secondary uppercase tracking-wider">
                    <Waves class="w-4 h-4" />
                    Coastal Delaware
                  </div>
                  <h3 class="mt-3 mb-2" style="font-family: var(--font-serif);">
                    {market.name}
                  </h3>
                  <p class="text-base-content/70 mb-6 flex-1">
                    {market.tagline}
                  </p>

                  <ul class="text-sm text-base-content/60 space-y-2 mb-6">
                    <li>
                      <strong>Highlights:</strong>{' '}
                      {market.highlights
                        .map((h) => h.title)
                        .slice(0, 2)
                        .join(', ')}
                      {market.highlights.length > 2 ? ', …' : ''}
                    </li>
                    <li>
                      <strong>Median Price:</strong>{' '}
                      {
                        market.stats.find((stat) =>
                          stat.label.includes('Median')
                        )?.value
                      }
                    </li>
                    <li>
                      <strong>Top Neighborhoods:</strong>{' '}
                      {market.neighborhoods.slice(0, 3).join(', ')}
                      {market.neighborhoods.length > 3 ? ', …' : ''}
                    </li>
                  </ul>

                  <a
                    href={`/areas/${market.slug}`}
                    class="btn btn-secondary btn-lg inline-flex items-center gap-2 w-full justify-center mt-auto"
                  >
                    View {market.name} Guide
                    <ArrowRight class="w-4 h-4" />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
