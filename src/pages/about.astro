---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { Image, getImage } from 'astro:assets';
import georgeUpClose from '../assets/george-up-close.jpg';
import georgeThumbsUp from '../assets/george-thumbs-up.jpg';
import iconBackground from '../assets/icon-background.png';
import {
  Heart,
  Users,
  Award,
  Star,
  CircleCheck,
  Shield,
  Home,
  TrendingUp,
  Phone,
} from '@lucide/astro';

const optimizedIconBackground = await getImage({
  src: iconBackground,
  format: 'webp',
});
---

<Layout
  title="About George Medairy - Delaware Real Estate Expert & Veteran Advocate"
  description="Meet George Medairy, your dedicated Delaware real estate agent specializing in residential properties and VA loans. Over 15 years of trusted service."
>
  <div class="min-h-screen">
    <header class="patriot-gradient shadow-xl text-primary-content">
      <Navbar />
    </header>

    {/* Hero Section */}
    <section class="patriot-gradient text-white py-20 relative overflow-hidden">
      <div class="pattern-dots absolute inset-0 opacity-20"></div>
      <div class="container max-w-7xl mx-auto px-4 relative z-10">
        <div class="text-center max-w-3xl mx-auto">
          <div
            class="inline-flex items-center gap-2 bg-accent/20 backdrop-blur-sm px-4 py-2 rounded-full mb-6"
          >
            <Shield class="w-5 h-5 text-accent" />
            <span class="text-sm font-semibold uppercase tracking-wider"
              >Delaware Real Estate Expert</span
            >
          </div>
          <h1 class="mb-6 text-shadow-lg">About George Medairy</h1>
          <p class="text-xl text-white/90 text-shadow">
            Your dedicated real estate partner in Delaware, committed to serving
            residential buyers, sellers, and honoring those who've served our
            nation.
          </p>
        </div>
      </div>
    </section>

    {/* Stats Section */}
    <section class="bg-base-200 py-12 border-y border-base-300">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-primary"
              style="font-family: var(--font-serif);"
            >
              15+
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Years Experience
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-secondary"
              style="font-family: var(--font-serif);"
            >
              500+
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Families Served
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-accent"
              style="font-family: var(--font-serif);"
            >
              $50M+
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              In Sales
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-primary"
              style="font-family: var(--font-serif);"
            >
              100%
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Dedication
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* My Story Section */}
    <section class="py-20 bg-base-100">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1">
            <Image
              src={georgeUpClose}
              alt="George Medairy - Delaware Real Estate Expert"
              class="rounded-2xl shadow-2xl"
            />
          </div>

          <div class="order-1 lg:order-2 space-y-6">
            <span
              class="text-accent font-semibold uppercase tracking-wider text-sm"
              >My Story</span
            >
            <h2>Helping Delawareans Find Home</h2>
            <div class="space-y-4 text-lg text-base-content/80 leading-relaxed">
              <p>
                For over 15 years, I've had the privilege of helping families
                across Delaware find their perfect home. Real estate isn't just
                about properties—it's about people, dreams, and new beginnings.
              </p>
              <p>
                What started as a passion for helping others has grown into a
                career built on trust, integrity, and deep local expertise. I
                understand the Delaware market inside and out—from the beaches
                to the suburbs, from first-time buyers to growing families.
              </p>
              <p>
                I'm particularly proud to serve our veterans, helping them
                navigate VA loans and leverage the benefits they've earned
                through their service. It's my honor to give back to those
                who've given so much.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 pt-4">
              <div
                class="inline-flex items-center gap-2 bg-primary/10 px-4 py-2 rounded-lg"
              >
                <Award class="w-5 h-5 text-primary" />
                <span class="font-semibold text-sm">Licensed Professional</span>
              </div>
              <div
                class="inline-flex items-center gap-2 bg-secondary/10 px-4 py-2 rounded-lg"
              >
                <Shield class="w-5 h-5 text-secondary" />
                <span class="font-semibold text-sm">Veteran Advocate</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Values Section */}
    <section class="py-20 bg-base-200 pattern-grid">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <span
            class="text-accent font-semibold uppercase tracking-wider text-sm"
            >Core Values</span
          >
          <h2 class="mt-4 mb-6">The Principles That Guide Me</h2>
          <p class="text-lg text-base-content/70">
            Every client deserves honesty, dedication, and results. These values
            are the foundation of how I do business.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mb-6"
            >
              <Heart class="w-8 h-8 text-primary" />
            </div>
            <h3 class="mb-4">Integrity</h3>
            <p class="text-base-content/70">
              Honest, transparent communication in every transaction. Your trust
              is earned through ethical practice and unwavering commitment to
              doing what's right.
            </p>
          </div>

          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-secondary/10 flex items-center justify-center mb-6"
            >
              <Users class="w-8 h-8 text-secondary" />
            </div>
            <h3 class="mb-4">Client-First Mindset</h3>
            <p class="text-base-content/70">
              Your goals become my goals. I listen carefully, understand deeply,
              and deliver personalized solutions that exceed expectations.
            </p>
          </div>

          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center mb-6"
            >
              <Award class="w-8 h-8 text-accent" />
            </div>
            <h3 class="mb-4">Excellence</h3>
            <p class="text-base-content/70">
              Continuous improvement in market knowledge, negotiation skills,
              and service quality. Settling for "good enough" isn't an option.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Why Choose Me Section */}
    <section class="py-20 bg-base-100">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-6">
            <span
              class="text-accent font-semibold uppercase tracking-wider text-sm"
              >Why Choose Me</span
            >
            <h2>Experience That Makes the Difference</h2>
            <p class="text-lg text-base-content/70 leading-relaxed">
              In a market this competitive, you need an agent who knows Delaware
              inside and out—someone who can anticipate challenges and turn them
              into opportunities.
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-4 bg-base-200 rounded-xl p-4">
                <div
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1"
                >
                  <Home class="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h4 class="font-bold mb-1">Deep Local Knowledge</h4>
                  <p class="text-base-content/70 text-sm">
                    15+ years of Delaware market expertise. I know the
                    neighborhoods, schools, market trends, and hidden gems that
                    make each area special.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4 bg-base-200 rounded-xl p-4">
                <div
                  class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center flex-shrink-0 mt-1"
                >
                  <Shield class="w-6 h-6 text-secondary" />
                </div>
                <div>
                  <h4 class="font-bold mb-1">VA Loan Specialist</h4>
                  <p class="text-base-content/70 text-sm">
                    Dedicated expertise in helping veterans navigate VA loans
                    and maximize their hard-earned benefits with zero-down
                    payment options.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4 bg-base-200 rounded-xl p-4">
                <div
                  class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0 mt-1"
                >
                  <Users class="w-6 h-6 text-accent" />
                </div>
                <div>
                  <h4 class="font-bold mb-1">Personalized Strategy</h4>
                  <p class="text-base-content/70 text-sm">
                    No cookie-cutter approaches. Every client gets a custom
                    strategy aligned with their unique goals, timeline, and
                    budget.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4 bg-base-200 rounded-xl p-4">
                <div
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1"
                >
                  <TrendingUp class="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h4 class="font-bold mb-1">Proven Track Record</h4>
                  <p class="text-base-content/70 text-sm">
                    500+ satisfied families, $50M+ in successful transactions,
                    and a reputation built on results that exceed expectations.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <Image
              src={georgeThumbsUp}
              alt="George Medairy - Trusted Delaware Realtor"
              class="rounded-2xl shadow-2xl"
            />
          </div>
        </div>
      </div>
    </section>

    {/* Call to Action Section */}
    <section class="py-20 patriot-gradient text-white relative overflow-hidden">
      <div class="pattern-dots absolute inset-0 opacity-20"></div>
      <div class="container mx-auto max-w-4xl px-4 text-center relative z-10">
        <h2 class="mb-6 text-shadow">Let's Work Together</h2>
        <p class="text-xl text-white/90 mb-8 text-shadow-sm max-w-2xl mx-auto">
          Whether you're buying your first home, selling a property, or helping
          a veteran find their dream home—I'm here to make it happen.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn btn-accent btn-lg">
            <Phone class="w-5 h-5" />
            Get In Touch
          </a>
          <a href="/explore" class="btn btn-secondary btn-lg">
            <Home class="w-5 h-5" />
            View Properties
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
