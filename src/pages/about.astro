---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { Image, getImage } from 'astro:assets';
import georgeUpClose from '../assets/george-up-close.jpg';
import georgeThumbsUp from '../assets/george-thumbs-up.jpg';
import handingOverKeys from '../assets/handing-over-keys.jpg';
import { SITE } from '../config/site';
import {
  Heart,
  Users,
  Award,
  Star,
  Shield,
  Home,
  TrendingUp,
  Phone,
} from '@lucide/astro';

const optimizedHandingOverKeys = await getImage({
  src: handingOverKeys,
  format: 'webp',
});

const aboutOgImage = await getImage({
  src: georgeUpClose,
  width: 1200,
  height: 630,
  format: 'webp',
});

const aboutStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About George Medairy',
    description:
      'Learn about George Medairy, a Delaware real estate expert and veteran advocate providing residential real estate services.',
    url: `${SITE.site}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.legalName,
    jobTitle: 'Real Estate Agent',
    worksFor: {
      '@type': 'RealEstateAgency',
      name: SITE.name,
      url: SITE.site,
    },
    email: SITE.contact.email,
    telephone: SITE.contact.phone,
    areaServed: SITE.serviceAreas,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE.site,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'About',
        item: `${SITE.site}/about`,
      },
    ],
  },
];
---

<Layout
  title="About George Medairy - Delaware Real Estate Expert & Veteran Advocate"
  description="Meet George Medairy, your dedicated Delaware real estate agent specializing in residential properties and VA loans. Over 15 years of trusted service."
  keywords={[
    'About George Medairy',
    'Delaware real estate expert',
    'veteran advocate realtor',
    'Rehoboth Beach agent background',
  ]}
  image={{
    src: aboutOgImage.src,
    width: aboutOgImage.width,
    height: aboutOgImage.height,
    alt: 'George Medairy smiling and ready to help Delaware home buyers',
  }}
  structuredData={aboutStructuredData}
>
  <div class="min-h-screen">
    {/* Hero Section */}
    <div class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <!-- Background Image -->
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url(${optimizedHandingOverKeys.src});`}
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>

      <!-- Navbar -->
      <header
        class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20"
      >
        <Navbar />
      </header>

      <!-- Hero Content -->
      <div class="relative h-[calc(60vh-5rem)] min-h-[420px]">
        <div class="relative z-10 h-full">
          <div
            class="container mx-auto max-w-7xl px-4 h-full flex items-center"
          >
            <div
              class="w-full max-w-3xl mx-auto text-center space-y-6 animate-fade-in-up"
            >
              <div class="inline-block">
                <span class="badge-veteran">
                  <Shield class="w-4 h-4" />
                  Delaware Real Estate Expert
                </span>
              </div>
              <h1 class="text-white text-shadow-lg">About George Medairy</h1>
              <p class="text-xl text-white/90 text-shadow leading-relaxed">
                Your dedicated real estate partner in Delaware, committed to
                serving residential buyers, sellers, and honoring those who've
                served our nation.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Stats Section */}
    <section
      class="py-12 border-y border-base-300"
      style="background-color: var(--color-section-cream);"
    >
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center">
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-primary"
              style="font-family: var(--font-serif);"
            >
              Fully
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Licensed & Ready
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-secondary"
              style="font-family: var(--font-serif);"
            >
              24/7
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Availability
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-accent"
              style="font-family: var(--font-serif);"
            >
              100%
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Client Focused
            </div>
          </div>
          <div class="space-y-2">
            <div
              class="text-4xl font-bold text-primary"
              style="font-family: var(--font-serif);"
            >
              Local
            </div>
            <div class="text-sm uppercase tracking-wider text-base-content/70">
              Delaware Expert
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* My Story Section */}
    <section
      class="py-20"
      style="background-color: var(--color-section-light);"
    >
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="order-2 lg:order-1">
            <Image
              src={georgeUpClose}
              alt="George Medairy - Delaware Real Estate Expert"
              class="rounded-2xl shadow-2xl"
            />
          </div>

          <div class="order-1 lg:order-2 space-y-6">
            <span
              class="text-accent font-semibold uppercase tracking-wider text-sm"
              >My Story</span
            >
            <h2>Helping Delawareans Find Home</h2>
            <div class="space-y-4 text-lg text-base-content/80 leading-relaxed">
              <p>
                Real estate is my passion, and helping families find their
                perfect home is what drives me every day. Real estate isn't just
                about properties—it's about people, dreams, and new beginnings.
              </p>
              <p>
                As a lifelong Delaware resident, I bring a deep understanding of
                our local communities—from the beaches to the suburbs, the
                hidden gems and the up-and-coming neighborhoods. My dedication
                to staying current with market trends, combined with genuine
                care for each client's unique needs, means I'm fully committed
                to making your real estate journey smooth and successful.
              </p>
              <p>
                I'm particularly passionate about serving our veterans, helping
                them navigate VA loans and leverage the benefits they've earned
                through their service. It's my honor to give back to those
                who've given so much for our country.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 pt-4">
              <div
                class="inline-flex items-center gap-2 bg-primary/10 px-4 py-2 rounded-lg"
              >
                <Award class="w-5 h-5 text-primary" />
                <span class="font-semibold text-sm">Licensed Professional</span>
              </div>
              <div
                class="inline-flex items-center gap-2 bg-secondary/10 px-4 py-2 rounded-lg"
              >
                <Shield class="w-5 h-5 text-secondary" />
                <span class="font-semibold text-sm">Veteran Advocate</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Values Section */}
    <section
      class="py-20 pattern-grid"
      style="background-color: var(--color-section-sage);"
    >
      <div class="container max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 max-w-3xl mx-auto">
          <span
            class="text-accent font-semibold uppercase tracking-wider text-sm"
            >Core Values</span
          >
          <h2 class="mt-4 mb-6">The Principles That Guide Me</h2>
          <p class="text-lg text-base-content/70">
            Every client deserves honesty, dedication, and results. These values
            are the foundation of how I do business.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mb-6"
            >
              <Heart class="w-8 h-8 text-primary" />
            </div>
            <h3 class="mb-4">Integrity</h3>
            <p class="text-base-content/70">
              Honest, transparent communication in every transaction. Your trust
              is earned through ethical practice and unwavering commitment to
              doing what's right.
            </p>
          </div>

          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-secondary/10 flex items-center justify-center mb-6"
            >
              <Users class="w-8 h-8 text-secondary" />
            </div>
            <h3 class="mb-4">Client-First Mindset</h3>
            <p class="text-base-content/70">
              Your goals become my goals. I listen carefully, understand deeply,
              and deliver personalized solutions that exceed expectations.
            </p>
          </div>

          <div
            class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center mb-6"
            >
              <Award class="w-8 h-8 text-accent" />
            </div>
            <h3 class="mb-4">Excellence</h3>
            <p class="text-base-content/70">
              Continuous improvement in market knowledge, negotiation skills,
              and service quality. Settling for "good enough" isn't an option.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Why Choose Me Section */}
    <section
      class="py-24 relative overflow-hidden bg-gradient-to-br from-[#2c3e50] via-[#34495e] to-[#2c3e50]"
    >
      <!-- Decorative background elements -->
      <div class="absolute inset-0 opacity-[0.03]">
        <div
          class="absolute inset-0"
          style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, currentColor 2px, currentColor 4px), repeating-linear-gradient(90deg, transparent, transparent 2px, currentColor 2px, currentColor 4px); background-size: 40px 40px;"
        >
        </div>
      </div>
      <div
        class="absolute top-0 right-0 w-1/2 h-full opacity-10 bg-gradient-to-l from-accent/30 to-transparent"
      >
      </div>

      <div class="container max-w-7xl mx-auto px-4 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-8">
            <div
              class="inline-flex items-center gap-3 bg-accent/20 backdrop-blur-sm px-5 py-2.5 rounded-full border border-accent/30"
            >
              <Star class="w-5 h-5 text-accent" />
              <span
                class="font-semibold uppercase tracking-[0.15em] text-sm text-accent"
                >Why Choose Me</span
              >
            </div>

            <div>
              <h2 class="text-white text-shadow mb-4">
                Experience That Makes the Difference
              </h2>
              <div
                class="w-20 h-1 bg-gradient-to-r from-accent to-accent/30 rounded-full"
              >
              </div>
            </div>

            <p class="text-lg text-white/80 leading-relaxed">
              In a market this competitive, you need an agent who knows Delaware
              inside and out—someone who can anticipate challenges and turn them
              into opportunities.
            </p>

            <div class="space-y-3">
              <div
                class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500"
                  >
                    <Home class="w-6 h-6 text-accent" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-bold text-white mb-1">
                      Deep Local Knowledge
                    </h4>
                    <p class="text-white/70 text-sm">
                      15+ years of Delaware market expertise. I know the
                      neighborhoods, schools, market trends, and hidden gems
                      that make each area special.
                    </p>
                  </div>
                </div>
                <div
                  class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                  <div
                    class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"
                  >
                  </div>
                  <div
                    class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"
                  >
                  </div>
                </div>
              </div>

              <div
                class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500"
                  >
                    <Shield class="w-6 h-6 text-accent" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-bold text-white mb-1">
                      VA Loan Specialist
                    </h4>
                    <p class="text-white/70 text-sm">
                      Dedicated expertise in helping veterans navigate VA loans
                      and maximize their hard-earned benefits with zero-down
                      payment options.
                    </p>
                  </div>
                </div>
                <div
                  class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                  <div
                    class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"
                  >
                  </div>
                  <div
                    class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"
                  >
                  </div>
                </div>
              </div>

              <div
                class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500"
                  >
                    <Users class="w-6 h-6 text-accent" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-bold text-white mb-1">
                      Personalized Strategy
                    </h4>
                    <p class="text-white/70 text-sm">
                      No cookie-cutter approaches. Every client gets a custom
                      strategy aligned with their unique goals, timeline, and
                      budget.
                    </p>
                  </div>
                </div>
                <div
                  class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                  <div
                    class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"
                  >
                  </div>
                  <div
                    class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"
                  >
                  </div>
                </div>
              </div>

              <div
                class="group relative bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 hover:bg-white/10 hover:border-accent/30 transition-all duration-500"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-accent/30 to-accent/10 flex items-center justify-center border border-accent/20 group-hover:scale-110 group-hover:border-accent/40 transition-all duration-500"
                  >
                    <TrendingUp class="w-6 h-6 text-accent" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-bold text-white mb-1">
                      Proven Track Record
                    </h4>
                    <p class="text-white/70 text-sm">
                      500+ satisfied families, $50M+ in successful transactions,
                      and a reputation built on results that exceed
                      expectations.
                    </p>
                  </div>
                </div>
                <div
                  class="absolute top-0 right-0 w-20 h-20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                  <div
                    class="absolute top-0 right-0 w-px h-8 bg-gradient-to-b from-accent to-transparent"
                  >
                  </div>
                  <div
                    class="absolute top-0 right-0 w-8 h-px bg-gradient-to-l from-accent to-transparent"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="relative lg:pl-8">
            <!-- Decorative frame -->
            <div
              class="absolute -inset-4 bg-gradient-to-br from-accent/20 via-accent/5 to-transparent rounded-3xl blur-2xl"
            >
            </div>
            <div
              class="absolute -top-6 -left-6 w-24 h-24 border-l-2 border-t-2 border-accent/40 rounded-tl-3xl"
            >
            </div>
            <div
              class="absolute -bottom-6 -right-6 w-24 h-24 border-r-2 border-b-2 border-accent/40 rounded-br-3xl"
            >
            </div>

            <Image
              src={georgeThumbsUp}
              alt="George Medairy - Trusted Delaware Realtor"
              class="relative rounded-md shadow-lg"
            />
          </div>
        </div>
      </div>
    </section>

    {/* Call to Action Section */}
    <section
      class="py-20 relative overflow-hidden"
      style="background-color: var(--color-section-cream);"
    >
      <div class="pattern-dots absolute inset-0 opacity-10"></div>
      <div class="container mx-auto max-w-4xl px-4 text-center relative z-10">
        <h2 class="mb-6">Let's Work Together</h2>
        <p class="text-xl text-base-content/80 mb-8 max-w-2xl mx-auto">
          Whether you're buying your first home, selling a property, or helping
          a veteran find their dream home—I'm here to make it happen.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn btn-accent btn-lg">
            <Phone class="w-5 h-5" />
            Get In Touch
          </a>
          <a href="/explore" class="btn btn-secondary btn-lg">
            <Home class="w-5 h-5" />
            View Properties
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
