---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image, getImage } from "astro:assets";
import georgeUpClose from "../assets/george-up-close.jpg";
import georgeThumbsUp from "../assets/george-thumbs-up.jpg";
import iconBackground from "../assets/icon-background.png";
import { Heart, Users, Award, Star, CircleCheck } from "@lucide/astro";

const optimizedIconBackground = await getImage({
  src: iconBackground,
  format: "webp",
});
---

<Layout
  title="About - George Medairy"
  description="Learn more about George Medairy, your dedicated real estate agent in Delaware. Discover our mission and values."
>
  <div class="min-h-screen">
    <header>
      <Navbar />
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-primary to-base-100 text-white py-16">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="text-center">
          <h1 class="text-5xl font-bold mb-4">About George Medairy</h1>
          <p class="text-xl text-blue-100 max-w-2xl mx-auto">
            Your dedicated real estate partner in Delaware, committed to making
            your property dreams a reality.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content Section -->
    <div class="bg-base-300">
      <div class="container max-w-7xl mx-auto py-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
          <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-3xl font-bold text-base-content mb-6">My Story</h2>
            <div class="space-y-4 text-lg text-base-content/80">
              <p>
                George Medairy is a dedicated real estate agent based in
                Delaware, committed to helping clients achieve their real estate
                goals. With a deep understanding of the local market and a
                passion for exceptional service, George is your trusted partner
                in navigating the complexities of buying, selling, or renting a
                home.
              </p>
              <p>
                Our mission is to provide personalized, professional guidance
                throughout the real estate process. We believe in building
                lasting relationships with our clients, understanding their
                unique needs, and delivering results that exceed expectations.
              </p>
            </div>
          </div>
          <div class="bg-white rounded-2xl shadow-xl">
            <Image
              src={georgeUpClose}
              alt="George Medairy"
              class="w-full rounded-2xl object-cover"
            />
          </div>
        </div>

        <!-- Values Section -->
        <section class="mb-16">
          <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-base-content mb-4">
              Core Values
            </h2>
            <p class="text-xl text-base-content/70 max-w-2xl mx-auto">
              The principles that guide everything we do in real estate
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div
              class="bg-primary text-primary-content rounded-2xl shadow-xl p-8 text-center hover:shadow-2xl transition-all duration-300"
            >
              <div
                class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <Heart class="w-8 h-8 text-primary-content" />
              </div>
              <h3 class="text-2xl font-bold mb-4">Integrity</h3>
              <p>
                We uphold the highest ethical standards in all our dealings,
                ensuring transparency and honesty in every transaction.
              </p>
            </div>

            <div
              class="bg-secondary text-secondary-content rounded-2xl shadow-xl p-8 text-center hover:shadow-2xl transition-all duration-300"
            >
              <div
                class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <Users class="w-8 h-8 text-secondary-content" />
              </div>
              <h3 class="text-2xl font-bold mb-4">Customer Focus</h3>
              <p>
                Our clients' needs are at the heart of everything we do. We
                listen, understand, and deliver personalized solutions.
              </p>
            </div>

            <div
              class="bg-accent text-accent-content rounded-2xl shadow-xl p-8 text-center hover:shadow-2xl transition-all duration-300"
            >
              <div
                class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <Award class="w-8 h-8 text-accent-content" />
              </div>
              <h3 class="text-2xl font-bold mb-4">Excellence</h3>
              <p>
                We strive for excellence in service and results, continuously
                improving to exceed expectations.
              </p>
            </div>
          </div>
        </section>
      </div>

      <!-- Services Section with Background -->
      <div
        class="bg-base-300 bg-size-[25%] border border-gray-400"
        style={`background-image: url(${optimizedIconBackground.src});`}
      >
        <div class="py-12 bg-base-300/30">
          <div class="container mx-auto max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
              <div class="space-y-6 text-xl">
                <h2 class="text-4xl font-bold mb-4">Why Choose Me?</h2>
                <div class="space-y-4">
                  <div class="flex items-start gap-4">
                    <CircleCheck
                      class="w-6 h-6 text-secondary mt-1 flex-shrink-0"
                    />
                    <div>
                      <h4 class="font-semibold text-base-content">
                        Local Market Expertise
                      </h4>
                      <p class="text-base-content/70">
                        Deep knowledge of Delaware's real estate market trends
                        and neighborhoods.
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start gap-4">
                    <CircleCheck
                      class="w-6 h-6 text-secondary mt-1 flex-shrink-0"
                    />
                    <div>
                      <h4 class="font-semibold text-base-content">
                        Personalized Approach
                      </h4>
                      <p class="text-base-content/70">
                        Tailored strategies that align with your unique goals
                        and timeline.
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start gap-4">
                    <CircleCheck
                      class="w-6 h-6 text-secondary mt-1 flex-shrink-0"
                    />
                    <div>
                      <h4 class="font-semibold text-base-content">
                        Full-Service Support
                      </h4>
                      <p class="text-base-content/70">
                        From initial consultation to closing day, I'm with you
                        every step.
                      </p>
                    </div>
                  </div>
                  <div class="flex items-start gap-4">
                    <CircleCheck
                      class="w-6 h-6 text-secondary mt-1 flex-shrink-0"
                    />
                    <div>
                      <h4 class="font-semibold text-base-content">
                        Proven Track Record
                      </h4>
                      <p class="text-base-content/70">
                        Consistently delivering results that exceed client
                        expectations.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <Image
                  src={georgeThumbsUp}
                  alt="George Medairy giving thumbs up"
                  class="rounded-lg shadow-lg"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to Action Section -->
      <div class="bg-primary text-primary-content">
        <div class="container mx-auto max-w-7xl py-16">
          <div class="bg-primary/50 text-center">
            <h2 class="text-3xl font-bold mb-4">Ready to Work Together?</h2>
            <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
              Let's discuss your real estate goals and create a plan to achieve
              them. Your dream property awaits!
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/contact" class="btn btn-lg btn-secondary"
                >Get In Touch</a
              >
              <a href="/explore" class="btn btn-lg btn-accent"
                >View Properties</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
