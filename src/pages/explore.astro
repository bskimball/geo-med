---
import LoanCalculator from '../components/LoanCalculator';
import Navbar from '../components/Navbar.astro';
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import iconBackground from '../assets/icon-background.png';
import dreamHome from '../assets/dream-home.jpg';
import sellHome from '../assets/sell-home.jpg';
import rentHome from '../assets/rent-home.jpg';
import {
  Search,
  Home,
  DollarSign,
  MapPin,
  Bed,
  Bath,
  Square,
  Heart,
  ArrowRight,
  Filter,
  SlidersHorizontal,
} from '@lucide/astro';

const optimizedIconBackground = await getImage({
  src: iconBackground,
  format: 'webp',
});

// Sample Delaware property listings
const properties = [
  {
    id: 1,
    title: 'Coastal Elegance in Rehoboth Beach',
    address: '123 Ocean Boulevard, Rehoboth Beach, DE',
    price: 875000,
    beds: 4,
    baths: 3.5,
    sqft: 3200,
    type: 'Single Family',
    image: dreamHome,
    featured: true,
    status: 'For Sale',
    description: 'Stunning beachfront property with panoramic ocean views, modern kitchen, and private deck.',
  },
  {
    id: 2,
    title: 'Historic Charm in Downtown Wilmington',
    address: '456 Market Street, Wilmington, DE',
    price: 425000,
    beds: 3,
    baths: 2.5,
    sqft: 2400,
    type: 'Townhouse',
    image: sellHome,
    featured: false,
    status: 'For Sale',
    description: 'Beautifully restored Victorian townhouse with original details and modern amenities.',
  },
  {
    id: 3,
    title: 'Modern Farmhouse in Newark',
    address: '789 Countryside Lane, Newark, DE',
    price: 565000,
    beds: 4,
    baths: 3,
    sqft: 2800,
    type: 'Single Family',
    image: rentHome,
    featured: false,
    status: 'For Sale',
    description: 'Contemporary farmhouse on 2 acres with open floor plan and gourmet kitchen.',
  },
  {
    id: 4,
    title: 'Waterfront Retreat in Lewes',
    address: '321 Harbor Drive, Lewes, DE',
    price: 695000,
    beds: 3,
    baths: 2.5,
    sqft: 2600,
    type: 'Single Family',
    image: dreamHome,
    featured: false,
    status: 'For Sale',
    description: 'Serene waterfront living with private dock, sunset views, and chef\'s kitchen.',
  },
  {
    id: 5,
    title: 'Luxury Condo in Dover',
    address: '555 Capital Plaza, Dover, DE',
    price: 325000,
    beds: 2,
    baths: 2,
    sqft: 1400,
    type: 'Condo',
    image: sellHome,
    featured: false,
    status: 'For Sale',
    description: 'High-rise luxury condo with city views, fitness center, and concierge service.',
  },
  {
    id: 6,
    title: 'Family Estate in Middletown',
    address: '888 Greenfield Road, Middletown, DE',
    price: 725000,
    beds: 5,
    baths: 4,
    sqft: 4200,
    type: 'Single Family',
    image: rentHome,
    featured: false,
    status: 'For Sale',
    description: 'Expansive family home with finished basement, pool, and 3-car garage.',
  },
];

const featuredProperty = properties.find((p) => p.featured);
const regularProperties = properties.filter((p) => !p.featured);
---

<Layout
  title="Explore Homes - George Medairy"
  description="Explore the real estate market in Delaware with George Medairy. Find your Delaware dream home or investment property today."
>
  <div class="min-h-screen">
    {/* Hero Section */}
    <div class="relative h-[60vh] min-h-[500px] overflow-hidden">
      <!-- Background Image -->
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url(${optimizedIconBackground.src});`}
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>

      <!-- Navbar -->
      <header class="relative z-20 bg-primary/30 backdrop-blur-md shadow-lg h-20">
        <Navbar />
      </header>

      <!-- Hero Content -->
      <div class="relative h-[calc(60vh-5rem)] min-h-[420px]">
        <div class="relative z-10 h-full">
          <div class="container mx-auto max-w-7xl px-4 h-full flex items-center">
            <div class="w-full max-w-3xl mx-auto text-center space-y-6 animate-fade-in-up">
              <div class="inline-block">
                <span class="badge-veteran">
                  <Home class="w-4 h-4" />
                  Delaware Homes
                </span>
              </div>
              <h1 class="text-white text-shadow-lg">Discover Your Dream Home</h1>
              <p class="text-xl text-white/90 text-shadow leading-relaxed">
                Explore exceptional properties across Delaware. From coastal retreats
                to urban sophistication, find the home that fits your lifestyle.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Search and Filter Bar */}
    <section
      class="sticky top-0 z-10 py-6 border-b border-base-300 shadow-lg backdrop-blur-md"
      style="background: rgba(255, 255, 255, 0.95);"
    >
      <div class="container max-w-7xl mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-4 items-center">
          {/* Search Input */}
          <div class="flex-1 w-full lg:w-auto">
            <div class="relative">
              <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-base-content/40" />
              <input
                type="text"
                placeholder="Search by city, zip, or neighborhood..."
                class="w-full pl-12 pr-4 py-3 rounded-xl border-2 border-base-300 focus:border-primary focus:outline-none transition-all duration-300 text-base"
              />
            </div>
          </div>

          {/* Filter Buttons */}
          <div class="flex gap-3 flex-wrap justify-center lg:justify-start">
            <button class="filter-btn">
              <DollarSign class="w-4 h-4" />
              <span>Price Range</span>
            </button>
            <button class="filter-btn">
              <Home class="w-4 h-4" />
              <span>Property Type</span>
            </button>
            <button class="filter-btn">
              <Bed class="w-4 h-4" />
              <span>Bedrooms</span>
            </button>
            <button class="filter-btn">
              <SlidersHorizontal class="w-4 h-4" />
              <span>More Filters</span>
            </button>
          </div>
        </div>

        {/* Active Filters Display */}
        <div class="mt-4 flex gap-2 flex-wrap">
          <span class="text-sm text-base-content/60">Showing <strong>6 properties</strong> in Delaware</span>
        </div>
      </div>
    </section>

    {/* Main Content Grid */}
    <section class="py-16" style="background-color: var(--color-section-light);">
      <div class="container max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-3 gap-8">
          {/* Left Column - Property Listings */}
          <div class="lg:col-span-2 space-y-8">
            {/* Featured Property - Hero Card */}
            {
              featuredProperty && (
                <div class="property-card-featured group">
                  <div class="relative h-[400px] overflow-hidden rounded-2xl">
                    <Image
                      src={featuredProperty.image}
                      alt={featuredProperty.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

                    {/* Featured Badge */}
                    <div class="absolute top-6 left-6">
                      <span class="px-4 py-2 rounded-full text-sm font-semibold uppercase tracking-wider backdrop-blur-md text-white border border-white/20" style="background: linear-gradient(135deg, rgba(217,160,91,0.9) 0%, rgba(168,93,68,0.9) 100%);">
                        Featured Property
                      </span>
                    </div>

                    {/* Price Badge */}
                    <div class="absolute top-6 right-6">
                      <div class="price-badge-large">
                        ${(featuredProperty.price / 1000).toFixed(0)}K
                      </div>
                    </div>

                    {/* Property Details Overlay */}
                    <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                      <div class="flex items-center gap-2 mb-3">
                        <MapPin class="w-4 h-4 text-accent" />
                        <span class="text-sm text-white/90">{featuredProperty.address}</span>
                      </div>
                      <h3 class="text-white mb-4 text-shadow">{featuredProperty.title}</h3>
                      <p class="text-white/90 mb-6 text-shadow-sm leading-relaxed">
                        {featuredProperty.description}
                      </p>
                      <div class="flex items-center gap-6 mb-6">
                        <div class="flex items-center gap-2">
                          <Bed class="w-5 h-5 text-accent" />
                          <span class="font-semibold">{featuredProperty.beds} Beds</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <Bath class="w-5 h-5 text-accent" />
                          <span class="font-semibold">{featuredProperty.baths} Baths</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <Square class="w-5 h-5 text-accent" />
                          <span class="font-semibold">{featuredProperty.sqft.toLocaleString()} sqft</span>
                        </div>
                      </div>
                      <button class="btn-primary-gradient">
                        <span>View Details</span>
                        <ArrowRight class="w-5 h-5" />
                      </button>
                    </div>
                  </div>
                </div>
              )
            }

            {/* Regular Property Grid - Bento Box Layout */}
            <div class="grid md:grid-cols-2 gap-6">
              {
                regularProperties.map((property, index) => (
                  <div
                    class="property-card group"
                    style={`animation-delay: ${index * 100}ms;`}
                  >
                    {/* Image Container */}
                    <div class="relative h-64 overflow-hidden rounded-t-2xl">
                      <Image
                        src={property.image}
                        alt={property.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                      {/* Favorite Button */}
                      <button class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-white hover:scale-110">
                        <Heart class="w-5 h-5 text-primary" />
                      </button>

                      {/* Price Badge */}
                      <div class="absolute bottom-4 right-4">
                        <div class="price-badge">
                          ${(property.price / 1000).toFixed(0)}K
                        </div>
                      </div>
                    </div>

                    {/* Content */}
                    <div class="p-6">
                      <div class="flex items-center gap-2 mb-3">
                        <MapPin class="w-4 h-4 text-primary" />
                        <span class="text-sm text-base-content/70">{property.address}</span>
                      </div>
                      <h4 class="mb-3 text-primary group-hover:text-accent transition-colors duration-300">
                        {property.title}
                      </h4>
                      <p class="text-base-content/70 mb-4 leading-relaxed line-clamp-2">
                        {property.description}
                      </p>

                      {/* Stats */}
                      <div class="flex items-center gap-4 mb-4 pb-4 border-b border-base-200">
                        <div class="flex items-center gap-1.5">
                          <Bed class="w-4 h-4 text-primary" />
                          <span class="text-sm font-medium">{property.beds}</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                          <Bath class="w-4 h-4 text-primary" />
                          <span class="text-sm font-medium">{property.baths}</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                          <Square class="w-4 h-4 text-primary" />
                          <span class="text-sm font-medium">{property.sqft.toLocaleString()}</span>
                        </div>
                      </div>

                      {/* Action */}
                      <button class="w-full btn-outline-primary group-hover:btn-primary-gradient transition-all duration-300">
                        <span>View Details</span>
                        <ArrowRight class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" />
                      </button>
                    </div>
                  </div>
                ))
              }
            </div>

            {/* Load More Section */}
            <div class="text-center pt-8">
              <button class="btn-secondary-gradient">
                <span>Load More Properties</span>
                <ArrowRight class="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Right Sidebar - Loan Calculator & Info */}
          <div class="lg:col-span-1">
            <div class="sticky top-32 space-y-6">
              {/* Loan Calculator Card */}
              <div class="card-elevated">
                <div class="p-6 border-b border-base-200">
                  <h4 class="text-primary">Calculate Your Payment</h4>
                  <p class="text-sm text-base-content/70 mt-2">
                    Get an estimate of your monthly mortgage payment
                  </p>
                </div>
                <div class="p-6">
                  <LoanCalculator client:load />
                </div>
              </div>

              {/* CTA Card */}
              <div class="card-gradient-sage p-8 text-white">
                <h4 class="text-white mb-4">Need Help Finding Your Home?</h4>
                <p class="text-white/90 mb-6 leading-relaxed">
                  Let me guide you through Delaware's real estate market with personalized service and expert knowledge.
                </p>
                <a href="/contact" class="btn-accent-gradient w-full cursor-pointer">
                  <span>Contact George</span>
                  <ArrowRight class="w-5 h-5" />
                </a>
              </div>

              {/* VA Loan Info Card */}
              <div class="card-elevated p-6">
                <div class="flex items-start gap-3 mb-4">
                  <div class="p-3 rounded-lg bg-primary/10">
                    <Home class="w-6 h-6 text-primary" />
                  </div>
                  <div>
                    <h5 class="text-primary mb-2">VA Loan Specialist</h5>
                    <p class="text-sm text-base-content/70 leading-relaxed">
                      Proud to serve veterans with VA loan expertise and dedicated support.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    /* Filter Buttons */
    .filter-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      border-radius: 0.75rem;
      border: 2px solid var(--color-base-300);
      background: white;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-base-content);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .filter-btn:hover {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(44, 74, 62, 0.15);
    }

    /* Property Cards */
    .property-card {
      background: white;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
    }

    .property-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .property-card-featured {
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Price Badges */
    .price-badge {
      padding: 0.625rem 1.25rem;
      border-radius: 624px;
      background: linear-gradient(135deg, rgba(217, 160, 91, 0.95) 0%, rgba(168, 93, 68, 0.95) 100%);
      backdrop-filter: blur(12px);
      color: white;
      font-weight: 700;
      font-size: 1.125rem;
      letter-spacing: -0.025em;
      box-shadow: 0 8px 24px rgba(217, 160, 91, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .price-badge-large {
      padding: 0.875rem 1.75rem;
      border-radius: 624px;
      background: linear-gradient(135deg, rgba(217, 160, 91, 0.95) 0%, rgba(168, 93, 68, 0.95) 100%);
      backdrop-filter: blur(12px);
      color: white;
      font-weight: 800;
      font-size: 1.5rem;
      letter-spacing: -0.025em;
      box-shadow: 0 12px 32px rgba(217, 160, 91, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Elevated Card */
    .card-elevated {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      transition: all 0.3s ease;
    }

    .card-elevated:hover {
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    }

    /* Gradient Sage Card */
    .card-gradient-sage {
      border-radius: 1rem;
      background: linear-gradient(135deg, #2c4a3e 0%, #3a6250 100%);
      box-shadow: 0 8px 24px rgba(44, 74, 62, 0.2);
    }

    /* Button Variants */
    .btn-primary-gradient {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      border-radius: 0.75rem;
      background: linear-gradient(135deg, #2c4a3e 0%, #3a6250 100%);
      color: white;
      font-weight: 600;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(44, 74, 62, 0.3);
    }

    .btn-primary-gradient:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 8px 24px rgba(44, 74, 62, 0.4);
    }

    .btn-secondary-gradient {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      border-radius: 0.75rem;
      background: linear-gradient(135deg, #a85d44 0%, #c67659 100%);
      color: white;
      font-weight: 600;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(168, 93, 68, 0.3);
    }

    .btn-secondary-gradient:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 8px 24px rgba(168, 93, 68, 0.4);
    }

    .btn-accent-gradient {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.875rem 1.75rem;
      border-radius: 0.75rem;
      background: linear-gradient(135deg, #d9a05b 0%, #edb970 100%);
      color: var(--color-base-content);
      font-weight: 700;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(217, 160, 91, 0.3);
    }

    .btn-accent-gradient:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 8px 24px rgba(217, 160, 91, 0.4);
    }

    .btn-outline-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      background: transparent;
      color: var(--color-primary);
      font-weight: 600;
      font-size: 0.9375rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: 2px solid var(--color-primary);
      cursor: pointer;
    }

    .btn-outline-primary:hover {
      background: linear-gradient(135deg, #2c4a3e 0%, #3a6250 100%);
      color: white;
      border-color: transparent;
    }

    /* Line Clamp */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>

  <script>
    // GSAP Scroll Animations
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Animate property cards on scroll
    gsap.from('.property-card', {
      scrollTrigger: {
        trigger: '.property-card',
        start: 'top 85%',
      },
      y: 50,
      opacity: 0,
      duration: 0.6,
      stagger: 0.15,
      ease: 'power2.out',
    });

    // Animate featured property
    gsap.from('.property-card-featured', {
      scrollTrigger: {
        trigger: '.property-card-featured',
        start: 'top 80%',
      },
      y: 60,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  </script>
</Layout>
